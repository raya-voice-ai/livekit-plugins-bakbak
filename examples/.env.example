# Copy to examples/.env and fill in. examples/.env is gitignored: never commit it.

# Bakbak text-to-speech (both examples)
BAKBAK_API_KEY=
# BAKBAK_BASE_URL=https://hub.getraya.app
# BAKBAK_VOICE_ID=009ae8b5-4a03-492d-af1c-3055989ac734
# BAKBAK_LANGUAGE=hi

# Speech-to-text and the LLM (agent.py only)
DEEPGRAM_API_KEY=
OPENAI_API_KEY=

# LiveKit server (agent.py only; these are the local dev server's defaults)
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
